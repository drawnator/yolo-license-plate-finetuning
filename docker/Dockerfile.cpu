# YOLO License Plate Fine-tuning – CPU Dockerfile
# ================================================
# CPU-only variant for machines without NVIDIA GPUs.
# Base image: Python 3.11 on Debian slim
#
# Usage:
#   docker compose -f docker/docker-compose-train-cpu.yml up --build --force-recreate

FROM python:3.11-slim

LABEL maintainer="drawnator"
LABEL description="YOLO license plate fine-tuning environment (CPU)"

# ── System packages ────────────────────────────────────────────────────────────
# libgl1-mesa-glx → libgl1 (package was removed in newer Debian; libgl1 provides
# the same OpenGL ABI). The other packages are direct dependencies of OpenCV.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        unzip \
        libgl1 \
        libglib2.0-0 \
        libxrender1 \
        libxext6 \
        libsm6 \
        libx11-6 \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ────────────────────────────────────────────────────────
# Install PyTorch CPU-only first (from the official CPU index),
# then install the rest of requirements (ultralytics pulls torch
# from pypi which includes CUDA — we pre-install CPU-only to prevent that).

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "polars[rtcompat]"

# ── Copy project files ─────────────────────────────────────────────────────────
COPY . .
RUN if [ ! -d /datasets ]; then mkdir -p /datasets; fi

# Verify the environment is sane
RUN python3 -c "import torch; print(f'PyTorch {torch.__version__} — CPU environment ready.')"

# ── Entrypoint: prepare datasets then run the pipeline ─────────────────────────
# Datasets are mounted from the host via docker-compose volume (./datasets:/datasets).
# prep_dataset.py is idempotent — it skips already-downloaded/extracted datasets.
COPY docker/entrypoint-cpu.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]
# Three-stage pipeline: generate synthetic plates, pretrain a strong teacher,
# run pseudo-labeling with that teacher, then train the final model.
# CPU runtime: fewer epochs and smaller synthetic count.
CMD ["python", "training/train_pipeline.py", "--synthetic", "1000", "--pretrain", "--device", "cpu", "--pretrain-epochs", "25", "--final-epochs", "50"]
