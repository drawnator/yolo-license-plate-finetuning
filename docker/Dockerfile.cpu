# YOLO License Plate Fine-tuning – CPU Dockerfile
# ================================================
# CPU-only variant for machines without NVIDIA GPUs.
# Base image: Python 3.11 on Debian slim
#
# Usage:
#   docker compose -f docker/docker-compose-train-cpu.yml up --build --force-recreate

FROM python:3.11-slim

LABEL maintainer="drawnator"
LABEL description="YOLO license plate fine-tuning environment (CPU)"

# ── System packages ────────────────────────────────────────────────────────────
# libgl1 provides the OpenGL ABI needed by OpenCV.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        unzip \
        libgl1 \
        libglib2.0-0 \
        libxrender1 \
        libxext6 \
        libsm6 \
        libx11-6 \
    && rm -rf /var/lib/apt/lists/*

# ── Python dependencies ────────────────────────────────────────────────────────
# Install PyTorch CPU-only first to prevent pip from pulling the CUDA variant.
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir "polars[rtcompat]"

# ── Copy project files ─────────────────────────────────────────────────────────
COPY . .
RUN if [ ! -d /datasets ]; then mkdir -p /datasets; fi

# Verify the environment is sane
RUN python3 -c "import torch; print(f'PyTorch {torch.__version__} — CPU environment ready.')"

# ── Entrypoint: prepare datasets then run the pipeline ─────────────────────────
COPY docker/entrypoint-cpu.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

# ── Default CMD (see python -m training.train_pipeline --help) ────────────────
#   --synthetic N          Generate N synthetic plate images (0 = skip)
#   --pretrain             Pretrain a teacher model on real + synthetic data
#   --regenerate-synthetic Force recreation of the synthetic dataset
#   --regenerate-pseudo    Force regeneration of pseudo-labels
#   --skip-pseudo / --skip-final   Skip a stage
#   --skip-export          Skip CoreML export (Linux/Docker; export on macOS later)
#   --teacher-weights PT   Use a specific .pt file as pseudo-labeling teacher
#   --base-model MODEL     Base model (default: yolo26s.pt)
#   --pretrain-epochs N    Epochs for pretraining (default: 50)
#   --final-epochs N       Epochs for final training (default: 100)
#   --batch-size N         Batch size (default: 16)
#   --device DEVICE        CUDA device or 'cpu' (default: 0)
#   --project DIR          Output directory (default: angelicam)
#   --name NAME            Training run name
#
# CPU defaults use fewer images / epochs to finish in reasonable time.
# CoreML export is skipped (requires macOS).
#
# NOTE: Uses "python -m" (not "python training/...") so sys.path includes the
# project root and can import sibling packages like synthetic_plates.
CMD ["python", "-m", "training.train_pipeline", "--synthetic", "1000", "--pretrain", "--device", "cpu", "--pretrain-epochs", "25", "--final-epochs", "50", "--skip-export"]